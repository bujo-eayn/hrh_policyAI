# ====================================================================
# Docker Environment Configuration for HRH-PolicyAI
# ====================================================================
# Copy this file to .env when running with Docker:
# cp .env.example .env
#
# IMPORTANT: Change JWT_SECRET_KEY before deploying to production!
# ====================================================================

# ====================================================================
# Database Configuration
# ====================================================================
# Use service name 'postgres' for inter-container communication
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hrh_policyai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ====================================================================
# JWT Authentication
# ====================================================================
# SECURITY: Generate a strong random key for production!
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================================================
# Ollama Configuration
# ====================================================================
# Ollama runs on the host machine, not in Docker
# Use host.docker.internal to access host from containers
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=gemma3:latest
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
OLLAMA_TIMEOUT=300

# ====================================================================
# Application Settings
# ====================================================================
APP_NAME=HRH-PolicyAI
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# ====================================================================
# API Configuration
# ====================================================================
API_PORT=8000
API_RELOAD=False

# ====================================================================
# Frontend Configuration
# ====================================================================
STREAMLIT_PORT=8501
# Use service name 'backend' for inter-container communication
API_BASE_URL=http://backend:8000/api/v1

# ====================================================================
# RAG Configuration
# ====================================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
DEFAULT_TOP_K=5
EMBEDDING_DIMENSION=1024
SIMILARITY_THRESHOLD=0.7

# ====================================================================
# File Upload Settings
# ====================================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=[".pdf",".docx"]

# ====================================================================
# Regulatory Bodies
# ====================================================================
REGULATORY_BODIES=["KMPDB","NCK","COC","PPB","PHOTC"]

# ====================================================================
# Security Settings
# ====================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_PER_MINUTE=60
